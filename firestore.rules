rules_version = '2';

// Palestra: a single owner reads and writes `sessions/*`; everything else is denied.
// Shape validation mirrors src/domain/validation.ts (validateSession).
//
// Known gaps vs validateSession. Rules have no loops and the 1000-expression budget
// per request is consumed fast by nested list access (measured on the emulator:
// validating 3 exercises x 3 sets already fails on a 5x4 document). So the rules check:
// - every top-level field (keys, types, ranges, text sizes, schemaVersion, timestamps);
// - the exercises list size (<= 30);
// - the FIRST 2 exercises: keys, types, text sizes, sets list size (<= 20),
//   and the values of their FIRST 2 sets (kg 0-500, reps int 0-100 or null, rpe 1-10 or null,
//   kg 0 = bodyweight requires reps >= 1).
// Exercises from the 3rd on, and sets from the 3rd on, are only checked client-side.
// A maximal legal document (30 exercises x 20 sets) stays well within the budget
// (tests/rules/sessions.test.ts). Dates are checked by regex, not as calendar dates
// (2026-02-30 passes here, the client rejects it).
// Writes are owner-only, so this validation guards against client bugs, not attackers.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'maieseluigi@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function validSet(s) {
      return s is map
        && s.keys().hasOnly(['weightKg', 'reps', 'rpe'])
        && s.weightKg is number && s.weightKg >= 0 && s.weightKg <= 500
        && (s.reps == null || (s.reps is int && s.reps >= 0 && s.reps <= 100))
        && (s.rpe == null || (s.rpe is number && s.rpe >= 1 && s.rpe <= 10))
        // weightKg 0 = bodyweight (corpo libero): reps are then required.
        && (s.weightKg > 0 || (s.reps != null && s.reps >= 1));
    }

    function setOk(sets, i) {
      return sets.size() <= i || validSet(sets[i]);
    }

    function validExercise(e) {
      return e is map
        && e.keys().hasOnly(['exerciseId', 'name', 'sets', 'notes'])
        && e.exerciseId is string && e.exerciseId.size() > 0 && e.exerciseId.size() <= 100
        && isText(e.name, 2000) && e.name.size() > 0
        && isText(e.notes, 2000)
        && e.sets is list && e.sets.size() <= 20
        && setOk(e.sets, 0)
        && setOk(e.sets, 1);
    }

    function exerciseOk(list, i) {
      return list.size() <= i || validExercise(list[i]);
    }

    function validSession(d) {
      return d.keys().hasOnly(['date', 'week', 'day', 'exercises', 'conditioning', 'notes',
                               'schemaVersion', 'createdAt', 'updatedAt'])
        && d.date is string
        && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && (d.week == null || (d.week is int && d.week >= 1 && d.week <= 8))
        && (d.day == null || d.day in ['A', 'B', 'C'])
        && isText(d.conditioning, 2000)
        && isText(d.notes, 2000)
        && d.schemaVersion == 1
        && d.exercises is list && d.exercises.size() <= 30
        && exerciseOk(d.exercises, 0)
        && exerciseOk(d.exercises, 1);
    }

    function validId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-(w[1-8]-[ABC]|extra)(-[0-9]{1,3})?$');
    }

    match /sessions/{sessionId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && validId(sessionId)
        && validSession(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && validSession(request.resource.data)
        // Legacy documents may lack createdAt: they stay editable, and createdAt stays absent.
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
